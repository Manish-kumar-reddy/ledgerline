# Copy to backend/.env (ignored by Git) and fill in the values. Never commit the real file.
# Values are read as Java properties: no quotes, and avoid backslashes.
# Generate each password separately with: openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-40

DB_URL=jdbc:postgresql://localhost:5432/ledgerline_db
TEST_DB_URL=jdbc:postgresql://localhost:5432/ledgerline_test_db

# Migration owner: used only by Flyway to create and change tables
DB_OWNER_USERNAME=ledgerline_owner
DB_OWNER_PASSWORD=

# Runtime role: used by the running application; owns no tables
DB_USERNAME=ledgerline_app
DB_PASSWORD=
